# Copia este archivo como .env y ajusta los valores a tu entorno.

# Base de datos PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_base?schema=public
DATABASE_URL="postgresql://postgres:contraseña@localhost:5432/finanzas_api?schema=public"

# Clave secreta para firmar y verificar los tokens JWT.
# Genera un valor aleatorio fuerte, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esta-clave-por-un-seguro-aleatorio"

# Duración de validez del access token (acepta valores tipo '1h', '30m', '7d', etc.)
JWT_EXPIRES_IN="1h"
